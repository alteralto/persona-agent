# Copy to .env and fill in. .env is gitignored — never put real keys in this file.
BOT_NICK=Pyhtun
# names players use in chat (reply when mentioned)
BOT_ALIASES=пыхтун,пыхтуна,пыхтуну
# comma-separated nicks of other AI characters (limits bot-to-bot back-and-forth)
OTHER_BOTS=
# replies in a row to other bots before waiting for a human (0 = unlimited)
MAX_BOT_REPLIES=0
# creative | survival
SERVER_MODE=creative
# react only when the bot is named in chat (keep true on busy servers)
REQUIRE_MENTION=true
# say something on its own after this much silence (0 = off)
IDLE_EVERY=4m
# greet the server on start
INTRO=true
# walk unvisited chunks around home when idle; radius in chunks
EXPLORE=true
EXPLORE_RADIUS=6
EXPLORE_AFTER=45s
PLACES_PATH=data\places.json
# when idle, stay next to the first of these players instead of exploring
COMPANIONS=
# names that address the other bots; a bot line opening with one of them is not for us
OTHERS_NAMES=
# no breaking/placing by the pathfinder within this many blocks of home (0 = off)
PROTECT_RADIUS=256
# voice service (voice/service.py): speak replies, receive recognized speech
VOICE=true
VOICE_SAY_URL=http://127.0.0.1:8091/say
VOICE_LISTEN=127.0.0.1:8092

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# slower model for questions about places and lines describing real actions (none = off)
GIGACHAT_SMART_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false

LAYA_URL=http://127.0.0.1:8090
LAYA_MIN_PROB=0.45
MCP_URL=http://127.0.0.1:25350/mcp
MC_SETTINGS=F:\.tlauncher\legacy\Minecraft\game\altoclef\altoclef_settings.json
